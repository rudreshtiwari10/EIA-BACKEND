PORT=5001

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_key
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173

# Gmail OAuth2 (used for sending emails — forgotPassword / OTP)
EMAIL=your_gmail@gmail.com
OAUTH_CLIENT_ID=your_google_oauth_client_id
OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
OAUTH_REFRESH_TOKEN=your_google_oauth_refresh_token

# Email display name
FROM_NAME=ExploreIndianIslands

# Optional external APIs
WEATHER_API_KEY=your_weather_api_key

# Google Gemini (Supports Matrix Rotation for scaling free-tiers)
# You can supply just one key, or a comma-separated list of multiple keys
GEMINI_API_KEYS=key1,key2,key3
# Or just GEMINI_API_KEY=key1

# Google Custom Search API (Optional: For Automated Image Enrichment)
# If provided, `npm run enrich-images` will fetch premium, ultra-aesthetic photography.
GOOGLE_SEARCH_API_KEY=AIzaSyBxOMx_rNSve2f1ryK_M9NpEKqsE1YdtRw
GOOGLE_SEARCH_CX=your_search_engine_id
